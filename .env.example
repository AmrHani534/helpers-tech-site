# ============================================================
# Helpers Technologies — environment variables
# Copy this file to .env.local for development or configure in
# your hosting provider (Vercel, etc.) for production.
# ============================================================

# --- Site --------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://helpers-tech.com

# --- Supabase (required for admin + contact submissions) --------
# Create a free project at https://supabase.com, then copy these
# from Project Settings → API. Keep the SERVICE_ROLE key private.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin bootstrap --------------------------------------------
# Email addresses in this comma-separated list are allowed into
# /admin after signing in with Supabase Auth. The first user who
# signs up with one of these emails becomes the admin.
ADMIN_EMAILS=info@helpers-tech.com

# --- Optional: Email notifications for contact messages ---------
# If set, contact form submissions will be forwarded to this
# address via Resend (https://resend.com).
RESEND_API_KEY=
CONTACT_NOTIFICATION_TO=info@helpers-tech.com
CONTACT_NOTIFICATION_FROM="Helpers Technologies <noreply@helpers-tech.com>"

# --- Optional: Floating AI chat assistant -----------------------
# If set, the floating chat widget will use Google Gemini. The
# widget degrades gracefully (hidden) when this is empty.
GOOGLE_GENERATIVE_AI_API_KEY=
